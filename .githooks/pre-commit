#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if ! command -v semgrep >/dev/null 2>&1; then
    echo "[pre-commit] semgrep not found; install it or run with --no-verify only after manual review"
    exit 1
fi

mapfile -t CPP_FILES < <(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$' || true)
if [ "${#CPP_FILES[@]}" -eq 0 ]; then
    exit 0
fi

echo "[pre-commit] Running semgrep on staged C/C++ files..."
"$ROOT/scripts/check-semgrep.sh" "${CPP_FILES[@]}"
