#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if ! command -v semgrep >/dev/null 2>&1; then
    echo "[pre-commit] semgrep not found; install it or run with --no-verify only after manual review"
    exit 1
fi

# Only source-like files: semgrep has no rules for (and can stall on) other
# staged files such as fixtures, images or sanitizer suppression lists.
mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(c|cc|cpp|cxx|h|hpp|qml|js|sh|py|ya?ml)$' || true)
if [ "${#STAGED_FILES[@]}" -eq 0 ]; then
    echo "[pre-commit] no source files staged; skipping semgrep"
    exit 0
fi

echo "[pre-commit] Running semgrep on staged files..."
"$ROOT/scripts/check-semgrep.sh" "${STAGED_FILES[@]}"
